---
import { Image } from 'astro:assets';
import capiDirector from '../assets/apps/capi-director-saluda.png';
import capiAviador from '../assets/apps/capi-aviador-juega.png';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const tx = t(lang);

// Íconos de las promesas, en el mismo orden que tx.nosotros.promesas
const iconos = [
	'<circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c1 1.3 2.2 2 3.5 2s2.5-.7 3.5-2"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/>',
	'<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 16l5-5 4 4 3-3 6 6"/><circle cx="16" cy="9" r="1.5"/>',
	'<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="16" r="1.4" fill="currentColor"/>',
	'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/>',
];
const colores = ['#ffc83d', '#13b5aa', '#ff8fb1', '#9a6cff'];
const video = import.meta.glob('/public/video/estudio.mp4')['/public/video/estudio.mp4'];
---

<section id="nosotros" class="relative scroll-mt-20 overflow-hidden bg-[#ffe9b0] py-24">
	<svg class="absolute inset-x-0 top-0 h-14 w-full -translate-y-px" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
		<path d="M0 0 H1440 V30 C1260 70 1080 70 900 40 S 540 0 360 30 S 120 60 0 40 Z" fill="#fff6e4" />
		<path d="M1440 30 C1260 70 1080 70 900 40 S 540 0 360 30 S 120 60 0 40" fill="none" stroke="#1e2a4a" stroke-width="4" vector-effect="non-scaling-stroke" />
	</svg>

	<div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 pt-6 md:px-8 lg:grid-cols-[1fr_1.1fr]">
		<div class="relative text-center lg:text-left">
			<p class="chip" data-entra>{tx.nosotros.chip}</p>
			<h2 class="titulo-juguete mt-5 text-[clamp(2.3rem,5.4vw,4rem)] text-estanque" data-entra>{tx.nosotros.titulo}</h2>
			<p class="mt-5 text-lg font-bold leading-relaxed text-tinta/80" data-entra>{tx.nosotros.texto}</p>

			{
				video ? (
					<video class="sticker mt-8 aspect-video w-full object-cover" muted loop playsinline preload="none" poster="/video/estudio.jpg" data-video-diferido data-entra>
						<source src="/video/estudio.webm" type="video/webm" />
						<source src="/video/estudio.mp4" type="video/mp4" />
					</video>
				) : (
					<div class="relative mx-auto mt-6 flex h-64 max-w-sm items-end justify-center gap-2" data-entra>
						<Image src={capiDirector} alt="" height={260} class="vaiven h-56 w-auto" style="--giro:3deg;--dur:3.2s" />
						<Image src={capiAviador} alt="" height={260} class="vaiven h-60 w-auto" style="--giro:-3deg;--dur:3.6s;--delay:-1s" />
					</div>
				)
			}
		</div>

		<ul class="grid gap-5 sm:grid-cols-2">
			{
				tx.nosotros.promesas.map((p, i) => (
					<li class={`sticker bg-papel p-6 ${i % 2 ? 'sm:translate-y-8' : ''}`} data-entra data-tilt>
						<span
							class="grid h-14 w-14 place-items-center rounded-2xl border-[3px] border-tinta shadow-[3px_4px_0_#1e2a4a]"
							style={`background:${colores[i]}`}
						>
							<svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="#1e2a4a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[i]} />
						</span>
						<h3 class="mt-4 font-titulo text-2xl tracking-wide">{p.titulo}</h3>
						<p class="mt-2 font-semibold text-tinta/75">{p.texto}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
