---
import { Image } from 'astro:assets';
import koi from '../assets/marca/koi.png';
import KoiSvg from './KoiSvg.astro';
import { APPS, ESTUDIO, MAIL_CONTACTO, PLAY_DESARROLLADOR } from '../config';
import { t, rutaInicio, otroIdioma, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const tx = t(lang);
const otro = otroIdioma(lang);
---

<footer id="contacto" class="relative scroll-mt-20 overflow-hidden bg-noche pb-10 pt-28 text-papel">
	<svg class="absolute inset-x-0 top-0 h-16 w-full -translate-y-px" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
		<path d="M0 0 H1440 V40 C1300 80 1120 85 940 50 S 600 5 420 40 S 140 80 0 50 Z" fill="#ffe9b0" />
		<path d="M1440 40 C1300 80 1120 85 940 50 S 600 5 420 40 S 140 80 0 50" fill="none" stroke="#1e2a4a" stroke-width="4" vector-effect="non-scaling-stroke" />
	</svg>

	<!-- Estanque de noche: burbujas y koi -->
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		{[8, 22, 41, 63, 80, 93].map((l, i) => (
			<span class="burbuja bottom-0" style={`left:${l}%;width:${10 + (i % 3) * 7}px;height:${10 + (i % 3) * 7}px;--dur:${8 + i}s;--delay:${i * 1.3}s`}></span>
		))}
		<div data-koi-nada class="absolute left-0 top-[30%] w-44 opacity-60"><KoiSvg class="w-full" /></div>
		<div data-koi-nada data-koi-inverso class="absolute left-0 top-[58%] w-32 opacity-50"><KoiSvg class="w-full" manchas="#ffc83d" /></div>
	</div>

	<div class="relative mx-auto max-w-4xl px-4 text-center md:px-8">
		<h2 class="titulo-juguete text-[clamp(2.6rem,7vw,4.8rem)] text-sol" data-entra>{tx.contacto.titulo}</h2>
		<p class="mx-auto mt-5 max-w-xl text-lg font-bold text-papel/85" data-entra>{tx.contacto.texto}</p>
		<div class="mt-9 flex flex-wrap justify-center gap-4" data-entra>
			{
				MAIL_CONTACTO && (
					<a href={`mailto:${MAIL_CONTACTO}`} class="boton bg-sol text-tinta" data-magnetico>
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<rect x="3" y="5" width="18" height="14" rx="2" />
							<path d="M3 7l9 6 9-6" />
						</svg>
						{tx.contacto.escribinos}
					</a>
				)
			}
			<a href={PLAY_DESARROLLADOR} target="_blank" rel="noopener" class="boton bg-papel text-tinta" data-magnetico>
				<svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d="M4 3l11 9-11 9z" fill="#13b5aa" stroke="#1e2a4a" stroke-width="2" stroke-linejoin="round" /></svg>
				{tx.contacto.verPlay}
			</a>
		</div>
	</div>

	<div class="relative mx-auto mt-24 flex max-w-6xl flex-col items-center justify-between gap-6 border-t-2 border-papel/20 px-4 pt-8 text-sm font-bold text-papel/75 md:flex-row md:px-8">
		<div class="flex items-center gap-3">
			<Image src={koi} alt="" width={40} height={40} class="h-10 w-10 rounded-full border-2 border-papel" />
			<span>© {new Date().getFullYear()} {ESTUDIO}. {tx.footer.derechos}</span>
		</div>
		<nav class="flex flex-wrap justify-center gap-x-5 gap-y-2">
			<a class="hover:text-sol" href={APPS.music.privacidad} target="_blank" rel="noopener">{tx.apps.privacidad} · {tx.apps.music.nombre}</a>
			<a class="hover:text-sol" href={APPS.learn.privacidad} target="_blank" rel="noopener">{tx.apps.privacidad} · {tx.apps.learn.nombre}</a>
			<a class="hover:text-sol" href={rutaInicio(otro)} hreflang={otro} data-idioma={otro}>{tx.nav.idiomaNombre}</a>
		</nav>
	</div>
	<p class="relative mt-6 text-center text-xs font-bold text-papel/50">{tx.footer.hecho}</p>
</footer>
