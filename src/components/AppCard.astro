---
import { Image } from 'astro:assets';
import { linkPlay } from '../config';
import type { Lang } from '../i18n';
import { t } from '../i18n';

interface Props {
	lang: Lang;
	app: 'music' | 'learn';
	icono: ImageMetadata;
	capi: ImageMetadata;
	miniaturas: ImageMetadata[];
	paquete: string;
	publicada: boolean;
	privacidad: string;
	// Fondo del panel de la imagen y color de acento
	fondo: string;
	acento: string;
	invertido?: boolean;
	video?: { mp4: string; webm: string; poster: string };
}

const { lang, app, icono, capi, miniaturas, paquete, publicada, privacidad, fondo, acento, invertido = false, video } =
	Astro.props;
const tx = t(lang);
const datos = tx.apps[app];
---

<article class="relative" data-entra>
	<div class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${invertido ? 'lg:[&>*:first-child]:order-2' : ''}`}>
		<!-- Panel de imagen: Capi grande (o el video loop), el ícono como sticker y juguetes -->
		<div class={`sticker relative overflow-visible p-6 ${video ? 'aspect-square' : 'aspect-[5/4]'}`} style={`background:${fondo}`} data-tilt>
			<div class="absolute inset-0 overflow-hidden rounded-[1.8rem]">
				<div class="absolute inset-0 opacity-25 [background-image:radial-gradient(#fff_2px,transparent_2.5px)] [background-size:26px_26px]"></div>
			</div>
			{
				video ? (
					<video
						class="absolute inset-3 h-[calc(100%-1.5rem)] w-[calc(100%-1.5rem)] rounded-[1.4rem] object-cover"
						muted
						loop
						playsinline
						preload="none"
						poster={video.poster}
						data-video-diferido
					>
						<source src={video.webm} type="video/webm" />
						<source src={video.mp4} type="video/mp4" />
					</video>
				) : (
					<Image
						src={capi}
						alt=""
						widths={[320, 520]}
						sizes="(min-width: 1024px) 26rem, 70vw"
						class="vaiven absolute bottom-4 left-1/2 h-[88%] w-auto -translate-x-1/2 drop-shadow-[6px_8px_0_rgba(30,42,74,0.35)]"
						style="--giro:2deg;--dur:3.6s"
					/>
				)
			}
			<Image
				src={icono}
				alt={datos.nombre}
				width={140}
				height={140}
				class="absolute -top-7 -right-5 h-24 w-24 rotate-6 rounded-[1.6rem] border-[3px] border-tinta shadow-[5px_6px_0_#1e2a4a] md:h-32 md:w-32"
				data-parallax="-0.08"
			/>
		</div>

		<!-- Texto -->
		<div class="text-center lg:text-left">
			<h3 class="titulo-juguete text-[clamp(2.1rem,4.6vw,3.4rem)]" style={`color:${acento}`}>{datos.nombre}</h3>
			<p class="mt-4 text-xl font-black">{datos.lema}</p>
			<p class="mt-3 text-lg font-semibold leading-relaxed text-tinta/80">{datos.texto}</p>
			<ul class="mt-6 flex flex-wrap justify-center gap-2 lg:justify-start">
				{datos.chips.map((c) => <li class="chip normal-case tracking-normal">{c}</li>)}
			</ul>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
				{
					publicada ? (
						<a href={linkPlay(paquete)} target="_blank" rel="noopener" class="boton bg-tinta text-papel" data-magnetico>
							<svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
								<path d="M4 2.5l11.5 9.5L4 21.5z" fill="#13b5aa" />
								<path d="M4 2.5l15 8.3-3.5 1.2z" fill="#ffc83d" />
								<path d="M4 21.5l15-8.3-3.5-1.2z" fill="#ff5a36" />
							</svg>
							{tx.apps.disponible}
						</a>
					) : (
						<span class="boton cursor-default bg-sol" aria-disabled="true">
							<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<circle cx="12" cy="12" r="9" />
								<path d="M12 7v5l3 2" />
							</svg>
							{tx.apps.muyPronto}
						</span>
					)
				}
				<a href={privacidad} target="_blank" rel="noopener" class="font-extrabold underline decoration-2 underline-offset-4 hover:text-koi">
					{tx.apps.privacidad}
				</a>
			</div>
		</div>
	</div>

	<!-- Cinta de miniaturas de sus juegos (duplicada para que el loop no se corte) -->
	<div class="relative mt-12 overflow-hidden py-3 [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]" aria-label={tx.apps.juegos}>
		<div class="cinta" style={`--dur:${miniaturas.length * 6}s;${invertido ? 'animation-direction:reverse' : ''}`}>
			{
				[...miniaturas, ...miniaturas].map((m, i) => (
					<Image
						src={m}
						alt=""
						height={150}
						class="h-28 w-auto shrink-0 rounded-2xl border-[3px] border-tinta bg-papel object-contain shadow-[4px_5px_0_#1e2a4a] md:h-36"
						aria-hidden={i >= miniaturas.length ? 'true' : undefined}
						loading="lazy"
					/>
				))
			}
		</div>
	</div>
</article>
